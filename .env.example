APP_NAME="QuickStudy LMS"
ENVIRONMENT="development"
API_PREFIX="/quickstudy"

# Network
API_HOST="0.0.0.0"
API_PORT=8001

# Server default timezone (IANA). API JSON datetimes are UTC-aware; browsers convert to local time.
# Optional: also set OS TZ (Unix/macOS). On Windows, rely on explicit UTC in responses.
TZ=Asia/Karachi
APP_TIMEZONE=Asia/Karachi

# SQLite database file path (relative paths are relative to project root)
SQLITE_PATH="quickstudy.db"

# Auth / JWT (replace in production)
JWT_SECRET_KEY="CHANGE_ME"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Uploads
UPLOADS_DIR="uploads"
MAX_UPLOAD_SIZE_MB=500

# CORS (comma-separated). Use explicit origins in production.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Place this file as ".env" in the project root (same folder as main.py). Required for transcript + summary.
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
# OpenAI Whisper API model for audio transcription
WHISPER_API_MODEL=whisper-1
# Word-alignment confidence floor when word-level data is present (0.0–1.0); lower keeps more words.
WHISPER_WORD_PROBABILITY_MIN=0.25